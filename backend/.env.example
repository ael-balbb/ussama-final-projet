# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT Secret (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Frontend URL (for CORS) - your custom domain
FRONTEND_URL=https://nasriphone.com

# Vercel preview hostname prefix
VERCEL_PROJECT_SLUG=ussama-final-projet

# Used only by `npm run seed`; never commit real values
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Port (Railway sets this automatically)
PORT=3001
